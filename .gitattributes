# The shell launcher must keep Unix line endings whatever machine commits it:
# a .sh checked in with CRLF fails on Linux with "bad interpreter".
*.sh text eol=lf

# And the Windows launcher keeps CRLF for the same reason in reverse.
*.bat text eol=crlf

# Binary, so git never tries to fix the line endings inside them.
*.png binary
*.ico binary

# Vendored web files are byte-for-byte copies with pinned hashes
# (smmap/web/vendor/VENDOR.md). A Windows checkout with core.autocrlf would
# otherwise turn their LF into CRLF and every hash would fail.
smmap/web/vendor/** -text

# Log fixtures mix CRLF and LF on purpose; git must not normalise them.
tests/fixtures/*.log -text
